# SQLite is used automatically for local development; no database setup is needed.
# The real .env file is git-ignored and must never be committed.

# To use MySQL instead, set DATABASE_URL to a valid connection string.
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/inventiq

# Connection pool tuning (optional)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# JWT authentication
# Replace this value before deploying outside local development.
JWT_SECRET_KEY=CHANGE_ME
JWT_EXPIRY_MINUTES=30