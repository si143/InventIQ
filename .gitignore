# Frontend dependencies and generated output
**/node_modules/
**/dist/
**/dist-ssr/

# Python environments, caches, and build output
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/env/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/
