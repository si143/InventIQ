**/.env
**/.env.*
!**/.env.example

# Local database, uploaded data, and generated model artifacts
backend/*.db
backend/*.sqlite
backend/*.sqlite3
backend/uploads/
backend/model_artifacts/

# Archived in-project recovery copy; keep the separate external backup
backup_before_simplification/

